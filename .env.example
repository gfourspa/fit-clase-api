# Firebase Configuration
# Estas variables son OBLIGATORIAS para el funcionamiento de Firebase Auth
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQ...\n-----END PRIVATE KEY-----\n"

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=fitclase_db
DB_SSL=false

# Server Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Invitation email (Resend free tier)
# Keep these empty in local development to skip email delivery.
RESEND_API_KEY=
INVITATION_EMAIL_FROM=Fit Clase <invitations@your-verified-domain.com>
# URL used to build the invitation acceptance link sent by email.
# In production this must be HTTPS and point to your API or a domain that opens the mobile app.
# Example for Render: https://fit-clase-api.onrender.com/api/v1/invitations/accept
# Example with custom domain (App Links): https://mi-dominio.cl/invitations/accept
INVITATION_ACCEPT_URL=http://localhost:4000/api/v1/invitations/accept

# OpenTelemetry / SigNoz
OTEL_SERVICE_NAME=api-fit-clase
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
